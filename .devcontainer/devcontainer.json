{
  "name": "IPSAE Notebook",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "waitFor": "postCreateCommand",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/ipsae-notebook/bin:${containerEnv:PATH}",
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/ipsae-notebook"
  },
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab",
      "onAutoForward": "ignore"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["ipsae_eval.ipynb"]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        "openai.chatgpt",
        "cweijan.vscode-office",
        "ArianJamasb.protein-viewer"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/ipsae-notebook/bin/python",
        "python.terminal.activateEnvironment": true,
        "notebook.defaultKernel": "ipsae-notebook",
        "workbench.editorAssociations": {
          "*.ipynb": "jupyter-notebook"
        }
      }
    }
  }
}
